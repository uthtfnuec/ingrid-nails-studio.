
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #fff8fb;
    color: #604653;
    line-height: 1.6;
}

header {
    text-align: center;
    padding: 45px 15px;
    background: #f9e0e9;
    border-bottom: 2px solid #d4af6a;
}

header h1 {
    font-family: Georgia, serif;
    color: #a64d70;
    font-size: 30px;
}

header p {
    margin-top: 8px;
}

nav {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
    padding: 18px 10px;
    background: #ffffff;
}

nav a {
    color: #a64d70;
    text-decoration: none;
    font-weight: bold;
    font-size: 14px;
}

main {
    max-width: 900px;
    margin: auto;
    padding: 15px;
}

section {
    background: #ffffff;
    margin: 25px 0;
    padding: 30px 20px;
    border-radius: 18px;
    border: 1px solid #f0dce5;
    box-shadow: 0 4px 15px rgba(150, 80, 110, 0.08);
}

section h2 {
    text-align: center;
    color: #a64d70;
    font-family: Georgia, serif;
    margin-bottom: 20px;
}

#inicio {
    text-align: center;
    background: #fff0f5;
    padding: 45px 20px;
}

#inicio p {
    margin: 15px 0 25px;
}

.botao {
    display: inline-block;
    background: #b86f8c;
    color: #ffffff;
    padding: 13px 24px;
    border: none;
    border-radius: 30px;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
}

.botao:hover {
    background: #984d6c;
}

#lista-servicos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
}

#form-agendamento {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

label {
    color: #a64d70;
    font-weight: bold;
}

input,
select {
    width: 100%;
    padding: 13px;
    border: 1px solid #e8cbd7;
    border-radius: 10px;
    background: #fffafd;
    font-size: 16px;
}

#form-agendamento button {
    margin-top: 15px;
}

#contato {
    text-align: center;
}

#contato p {
    margin: 10px 0;
}

footer {
    text-align: center;
    padding: 25px 15px;
    background: #f9e0e9;
    border-top: 2px solid #d4af6a;
    color: #80586a;
    font-size: 13px;
}

@media screen and (max-width: 480px) {
    header h1 {
        font-size: 26px;
    }

    nav {
        gap: 12px;
    }

    section {
        padding: 22px 15px;
    }
}
